# ─── DVC ─────────────────────────────────────────────────────────────────────
.dvc/cache/
.dvc/tmp/
# Do NOT add data/raw/ here — DVC generates its own .gitignore inside it
# when you run `dvc add data/raw/v0` etc.

# ─── Processed data CSVs (tracked by DVC as .dvc pointer files) ──────────────
data/processed/*.csv
# Keep .dvc pointer files and .gitignore generated by DVC
!data/processed/*.dvc
!data/processed/.gitignore

# ─── MLflow ──────────────────────────────────────────────────────────────────
mlflow.db
mlruns/

# ─── Feast online store (regenerated on each materialize) ────────────────────
feature_store/data/online_store.db
feature_store/registry.db

# ─── Model binaries (large files — managed separately) ───────────────────────
models/*.pkl
models/*.joblib
models/*.bin
# Keep JSON metadata
!models/*.json
!models/.gitkeep

# ─── Generated reports ────────────────────────────────────────────────────────
reports/confusion_matrix.png
reports/per_stock_metrics.csv
reports/classification_report_*.json
reports/tuning_results.csv
reports/cml_report.md
report.md
# Keep .gitkeep
!reports/.gitkeep

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# ─── IDE ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ─── Secrets ─────────────────────────────────────────────────────────────────
service_account*.json
*_key.json
